---
import { ArrowRight, Play, Shield, Users, Zap } from 'lucide-astro';

const stats = [
  { value: "15+", label: "Años de Experiencia" },
  { value: "500+", label: "Clientes Activos" },
  { value: "98%", label: "Tasa de Recuperación" },
  { value: "24/7", label: "Soporte Continuo" },
];
---

<section
  id="inicio"
  class="relative min-h-screen overflow-hidden bg-primary"
>
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#04C9CD_1px,transparent_1px),linear-gradient(to_bottom,#04C9CD_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
  </div>

  <!-- Animated Circles -->
  <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-secondary/20 blur-3xl"></div>
  <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-secondary/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-32 pb-20 sm:px-6 lg:px-8 lg:pt-40">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-8 lg:items-center">
      <!-- Content -->
      <div class="max-w-2xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-secondary/30 bg-secondary/10 px-4 py-2">
          <span class="flex h-2 w-2 rounded-full bg-secondary animate-pulse"></span>
          <span class="text-sm font-medium text-secondary">
            Soluciones de gestión empresarial
          </span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
          <span class="block">Gestión Profesional</span>
          <span class="mt-2 block text-secondary">
            de Cobranza y Servicios
          </span>
        </h1>

        <p class="mt-6 text-lg leading-relaxed text-white/80">
          Somos especialistas en recuperación de cartera, gestión judicial y
          servicios de contacto. Combinamos tecnología de punta con
          experiencia humana para maximizar sus resultados.
        </p>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a
            href="#servicios"
            class="inline-flex items-center justify-center rounded-md bg-secondary px-6 py-3 text-base font-semibold text-primary hover:bg-secondary/90 transition-colors"
          >
            Nuestros Servicios
            <ArrowRight class="ml-2 h-5 w-5" />
          </a>
          <a
            href="#nosotros"
            class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-medium text-white hover:bg-white/10 transition-colors"
          >
            <Play class="mr-2 h-5 w-5" />
            Conoce Más
          </a>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-2">
            <Shield class="h-5 w-5 text-secondary" />
            <span class="text-sm text-white/70">100% Confidencial</span>
          </div>
          <div class="flex items-center gap-2">
            <Users class="h-5 w-5 text-secondary" />
            <span class="text-sm text-white/70">Equipo Certificado</span>
          </div>
          <div class="flex items-center gap-2">
            <Zap class="h-5 w-5 text-secondary" />
            <span class="text-sm text-white/70">Respuesta Rápida</span>
          </div>
        </div>
      </div>

      <!-- Stats Card -->
      <div class="relative">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
          <h3 class="mb-6 text-lg font-semibold text-white">
            Nuestros Números
          </h3>
          <div class="grid grid-cols-2 gap-6">
            {stats.map((stat) => (
              <div class="group rounded-xl border border-white/10 bg-white/5 p-4 transition-all hover:border-secondary/50 hover:bg-secondary/10">
                <div class="text-3xl font-bold text-secondary">
                  {stat.value}
                </div>
                <div class="mt-1 text-sm text-white/70">{stat.label}</div>
              </div>
            ))}
          </div>

          <!-- CTA inside card -->
          <div class="mt-8 rounded-xl bg-secondary/20 p-4">
            <p class="text-sm text-white/80">
              ¿Necesitas conocer tu situación?
            </p>
            <a
              href="#saber-deuda"
              class="mt-3 inline-flex w-full items-center justify-center rounded-md bg-secondary px-4 py-2 text-sm font-medium text-primary hover:bg-secondary/90 transition-colors"
            >
              Consulta tu Deuda
            </a>
          </div>
        </div>

        <!-- Floating Elements -->
<!--         <div class="absolute -left-4 top-1/4 hidden rounded-lg border border-white/10 bg-primary/90 px-4 py-2 backdrop-blur-sm lg:block">
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-green-500/20">
              <div class="h-2 w-2 rounded-full bg-green-500"></div>
            </div>
            <span class="text-sm text-white">Activo 24/7</span>
          </div>
        </div> -->
      </div>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg
      viewBox="0 0 1440 120"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full"
      preserveAspectRatio="none"
    >
      <path
        d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z"
        class="fill-background"
      />
    </svg>
  </div>
</section>
