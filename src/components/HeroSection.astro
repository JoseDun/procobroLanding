---
import { ArrowRight, Play, Shield, Users, Zap, CheckCircle2 } from 'lucide-astro';

const valuePoints = [
  "Tecnología + experiencia humana",
  "Cobertura nacional",
  "Gestión multicanal",
  "Respuesta ágil y trazabilidad",
  "+ de 10 años en el mercado",
];
---

<section
  id="inicio"
  class="relative min-h-screen overflow-hidden bg-primary"
>
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#04C9CD_1px,transparent_1px),linear-gradient(to_bottom,#04C9CD_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
  </div>

  <!-- Animated Circles -->
  <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-secondary/20 blur-3xl"></div>
  <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-secondary/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-32 pb-20 sm:px-6 lg:px-8 lg:pt-40">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-8 lg:items-center">
      <!-- Content -->
      <div class="max-w-2xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-secondary/30 bg-secondary/10 px-4 py-2">
          <span class="flex h-2 w-2 rounded-full bg-secondary animate-pulse"></span>
          <span class="text-sm font-medium text-secondary">
            Soluciones de gestión empresarial
          </span>
        </div>

        <h1
          class="typewriter-heading relative text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl"
          aria-label="Gestión Profesional de Cobranza y Servicios"
        >
          <span class="block invisible" aria-hidden="true">
            <span class="block">Gestión Profesional</span>
            <span class="mt-2 block text-secondary">
              de Cobranza y Servicios
            </span>
          </span>

          <span class="absolute inset-0 block" aria-hidden="true">
            <span
              class="typewriter-line block"
              data-typewriter-line
              data-typewriter-text="Gestión Profesional"
            >
              Gestión Profesional
            </span>
            <span
              class="typewriter-line mt-2 block text-secondary"
              data-typewriter-line
              data-typewriter-text="de Cobranza y Servicios"
            >
              de Cobranza y Servicios
            </span>
          </span>
        </h1>

        <p class="mt-6 text-lg leading-relaxed text-white/80">
          Somos especialistas en recuperación, gestión judicial y servicios
          de contacto. Combinamos tecnología de punta con experiencia humana
          especializada para maximizar sus resultados.
        </p>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a
            href="#servicios"
            class="inline-flex items-center justify-center rounded-md bg-secondary px-6 py-3 text-base font-semibold text-primary hover:bg-secondary/90 transition-colors"
          >
            Nuestros Servicios
            <ArrowRight class="ml-2 h-5 w-5" />
          </a>
          <a
            href="#nosotros"
            class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-medium text-white hover:bg-white/10 transition-colors"
          >
            <Play class="mr-2 h-5 w-5" />
            Conoce Mas
          </a>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-2">
            <Shield class="h-5 w-5 text-secondary" />
            <span class="text-sm text-white/70">Confianza</span>
          </div>
          <div class="flex items-center gap-2">
            <Users class="h-5 w-5 text-secondary" />
            <span class="text-sm text-white/70">Equipos especializados</span>
          </div>
          <div class="flex items-center gap-2">
            <Zap class="h-5 w-5 text-secondary" />
            <span class="text-sm text-white/70">Eficiencia</span>
          </div>
        </div>
      </div>

      <!-- Value Proposition Card -->
      <div class="relative">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
          <h3 class="mb-6 text-lg font-semibold text-white">
            Propuesta de valor
          </h3>
          <div class="grid gap-4 sm:grid-cols-2">
            {valuePoints.map((point) => (
              <div class="group flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 p-4 transition-all hover:border-secondary/50 hover:bg-secondary/10">
                <CheckCircle2 class="mt-0.5 h-5 w-5 flex-shrink-0 text-secondary" />
                <span class="text-sm font-medium leading-relaxed text-white/80">
                  {point}
                </span>
              </div>
            ))}
          </div>

          <div class="mt-8 rounded-xl bg-secondary/20 p-4">
            <p class="text-sm text-white/80">
              ¿Necesitas hablar con nuestro equipo?
            </p>
            <a
              href="#contacto"
              class="mt-3 inline-flex w-full items-center justify-center rounded-md bg-secondary px-4 py-2 text-sm font-medium text-primary hover:bg-secondary/90 transition-colors"
            >
              Contactar a Procobro
            </a>
          </div>
        </div>

        <!-- Floating Elements -->
<!--         <div class="absolute -left-4 top-1/4 hidden rounded-lg border border-white/10 bg-primary/90 px-4 py-2 backdrop-blur-sm lg:block">
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-green-500/20">
              <div class="h-2 w-2 rounded-full bg-green-500"></div>
            </div>
            <span class="text-sm text-white">Activo 24/7</span>
          </div>
        </div> -->
      </div>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg
      viewBox="0 0 1440 120"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full"
      preserveAspectRatio="none"
    >
      <path
        d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z"
        class="fill-background"
      />
    </svg>
  </div>
</section>

<script>
  const typewriterLines = Array.from(
    document.querySelectorAll<HTMLElement>('[data-typewriter-line]')
  );
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const sleep = (duration: number) => new Promise(resolve => window.setTimeout(resolve, duration));

  const typeLine = async (line: HTMLElement, text: string) => {
    line.classList.add('is-typing');

    for (let index = 0; index <= text.length; index += 1) {
      line.textContent = text.slice(0, index);
      await sleep(index === 0 ? 180 : 42);
    }

    line.classList.remove('is-typing');
  };

  const eraseLine = async (line: HTMLElement, text: string) => {
    line.classList.add('is-typing');

    for (let index = text.length; index >= 0; index -= 1) {
      line.textContent = text.slice(0, index);
      await sleep(24);
    }

    line.classList.remove('is-typing');
  };

  const runTypewriter = async () => {
    if (!typewriterLines.length || reduceMotion) return;

    const lines = typewriterLines.map(line => line.dataset.typewriterText || line.textContent?.trim() || '');
    typewriterLines.forEach(line => {
      line.textContent = '';
      line.classList.remove('is-typing');
    });

    while (true) {
      for (const [lineIndex, text] of lines.entries()) {
        const line = typewriterLines[lineIndex];
        if (line) await typeLine(line, text);
        await sleep(180);
      }

      typewriterLines.at(-1)?.classList.add('is-typing');
      await sleep(1800);
      typewriterLines.at(-1)?.classList.remove('is-typing');

      for (let lineIndex = lines.length - 1; lineIndex >= 0; lineIndex -= 1) {
        const line = typewriterLines[lineIndex];
        if (line) await eraseLine(line, lines[lineIndex]);
        await sleep(120);
      }

      await sleep(450);
    }
  };

  runTypewriter();
</script>

<style>
  .typewriter-line {
    min-height: 1.05em;
  }

  .typewriter-line.is-typing::after {
    display: inline-block;
    width: 0.08em;
    height: 0.82em;
    margin-left: 0.08em;
    vertical-align: -0.08em;
    background: currentColor;
    content: "";
    animation: typewriter-blink 0.85s steps(2, start) infinite;
  }

  @keyframes typewriter-blink {
    0%,
    45% {
      opacity: 1;
    }

    46%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-line.is-typing::after {
      display: none;
    }
  }
</style>
