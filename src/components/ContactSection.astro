---
import {
  MapPin,
  Phone,
  Mail,
  Clock,
  MessageCircle,
  Send,
  Building,
  User,
  FileText,
} from 'lucide-astro';

const contactInfo = [
  {
    icon: "MapPin",
    title: "Dirección",
    content: "Av. Principal 1234, Oficina 501, Santiago",
  },
  {
    icon: "Phone",
    title: "Teléfono",
    content: "+56 2 2345 6789",
  },
  {
    icon: "Mail",
    title: "Email",
    content: "contacto@Procobro.cl",
  },
  {
    icon: "Clock",
    title: "Horario",
    content: "Lunes a Viernes: 9:00 - 18:00",
  },
];
---

<section id="contacto" class="py-20 lg:py-32 bg-muted/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-sm font-semibold uppercase tracking-wider text-secondary mb-4">
        Contacto
      </span>
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        ¿Quieres Nuestros <span class="text-secondary">Servicios?</span>
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Estamos listos para ayudarte. Completa el formulario o contáctanos
        directamente.
      </p>
    </div>

    <div class="grid gap-12 lg:grid-cols-2">
      <!-- Contact Form -->
      <div class="rounded-2xl border border-border bg-card p-8 lg:p-10">
        <h3 class="text-xl font-bold text-foreground mb-6">
          Solicita Información
        </h3>
        <form id="contact-form" class="space-y-6">
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="name" class="block text-sm font-medium text-foreground">Nombre Completo</label>
              <div class="relative">
                <User class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Tu nombre"
                  class="h-10 w-full rounded-md border border-input bg-background pl-10 pr-3 text-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"
                  required
                />
              </div>
            </div>
            <div class="space-y-2">
              <label for="company" class="block text-sm font-medium text-foreground">Empresa</label>
              <div class="relative">
                <Building class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <input
                  id="company"
                  name="company"
                  type="text"
                  placeholder="Nombre de tu empresa"
                  class="h-10 w-full rounded-md border border-input bg-background pl-10 pr-3 text-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"
                />
              </div>
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="email" class="block text-sm font-medium text-foreground">Email</label>
              <div class="relative">
                <Mail class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="tu@email.com"
                  class="h-10 w-full rounded-md border border-input bg-background pl-10 pr-3 text-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"
                  required
                />
              </div>
            </div>
            <div class="space-y-2">
              <label for="phone" class="block text-sm font-medium text-foreground">Teléfono</label>
              <div class="relative">
                <Phone class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  placeholder="+56 9 1234 5678"
                  class="h-10 w-full rounded-md border border-input bg-background pl-10 pr-3 text-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"
                />
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label for="service" class="block text-sm font-medium text-foreground">Servicio de Interés</label>
            <div class="relative">
              <FileText class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
              <select
                id="service"
                name="service"
                class="h-10 w-full rounded-md border border-input bg-background pl-10 pr-3 text-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"
              >
                <option value="">Selecciona un servicio</option>
                <option value="cobranza">Cobranza</option>
                <option value="prejudicial">Prejudicial</option>
                <option value="judicial">Judicial</option>
                <option value="telemarketing">Telemarketing</option>
                <option value="atencion">Atención al Cliente</option>
                <option value="otro">Otro</option>
              </select>
            </div>
          </div>

          <div class="space-y-2">
            <label for="message" class="block text-sm font-medium text-foreground">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Cuéntanos sobre tu necesidad..."
              class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-base font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
          >
            <Send class="mr-2 h-5 w-5" />
            Enviar Solicitud
          </button>
        </form>
      </div>

      <!-- Contact Info & WhatsApp -->
      <div class="space-y-8">
        <!-- Contact Info Cards -->
        <div class="grid gap-4 sm:grid-cols-2">
          {contactInfo.map((item) => (
            <div class="rounded-xl border border-border bg-card p-5 transition-all hover:border-secondary/50">
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-secondary/10 text-secondary">
                  {item.icon === "MapPin" && <MapPin class="h-5 w-5" />}
                  {item.icon === "Phone" && <Phone class="h-5 w-5" />}
                  {item.icon === "Mail" && <Mail class="h-5 w-5" />}
                  {item.icon === "Clock" && <Clock class="h-5 w-5" />}
                </div>
                <div>
                  <p class="font-semibold text-foreground">
                    {item.title}
                  </p>
                  <p class="text-sm text-muted-foreground">
                    {item.content}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- WhatsApp CTA -->
        <div class="rounded-2xl border border-green-500/30 bg-green-500/10 p-8">
          <div class="flex items-center gap-4 mb-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-green-500 text-white">
              <MessageCircle class="h-7 w-7" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-foreground">
                WhatsApp Directo
              </h3>
              <p class="text-muted-foreground">
                Respuesta inmediata
              </p>
            </div>
          </div>
          <p class="text-muted-foreground mb-6">
            Escríbenos directamente por WhatsApp para una atención más
            rápida y personalizada.
          </p>
          <a
            href="https://wa.me/56912345678"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center rounded-md bg-green-500 px-6 py-3 text-base font-medium text-white hover:bg-green-600 transition-colors"
          >
            <MessageCircle class="mr-2 h-5 w-5" />
            Chatear por WhatsApp
          </a>
        </div>

        <!-- Map Placeholder -->
        <div
          id="zona-geografica"
          class="rounded-2xl border border-border bg-card p-8"
        >
          <h3 class="text-xl font-bold text-foreground mb-4">
            Zona Geográfica
          </h3>
          <p class="text-muted-foreground mb-4">
            Operamos en todo Chile con cobertura nacional. Nuestras oficinas
            principales se encuentran en Santiago, con presencia en las
            principales ciudades del país.
          </p>
          <div class="aspect-video rounded-xl bg-muted flex items-center justify-center">
            <div class="text-center">
              <MapPin class="h-12 w-12 text-muted-foreground mx-auto mb-2" />
              <p class="text-muted-foreground">
                Cobertura Nacional
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  
  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Gracias por contactarnos. Nos comunicaremos pronto.');
    contactForm.reset();
  });
</script>
