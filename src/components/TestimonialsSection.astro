---
import { Star, Quote } from 'lucide-astro';

const testimonials = [
  {
    name: "María González",
    role: "Gerente de Cobranza",
    company: "Banco Nacional",
    content:
      "Excelente servicio. Desde que trabajamos con ellos, nuestra tasa de recuperación aumentó un 40%. El equipo es profesional y la tecnología que utilizan es de primer nivel.",
    rating: 5,
  },
  {
    name: "Carlos Rodríguez",
    role: "Director Financiero",
    company: "Seguros Unidos",
    content:
      "La implementación de su CRM y la integración con nuestros sistemas fue impecable. El soporte 24/7 nos da la tranquilidad que necesitamos.",
    rating: 5,
  },
  {
    name: "Ana Martínez",
    role: "Jefa de Operaciones",
    company: "TeleCom Plus",
    content:
      "Su enfoque omnicanal revolucionó nuestra gestión de clientes. Los resultados hablan por sí solos: mejor recuperación y clientes más satisfechos.",
    rating: 5,
  },
];
---

<section id="resenas" class="py-20 lg:py-32 bg-background">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-sm font-semibold uppercase tracking-wider text-secondary mb-4">
        Testimonios
      </span>
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        Lo que Dicen <span class="text-secondary">Nuestros Clientes</span>
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        La satisfacción de nuestros clientes es nuestra mejor carta de
        presentación
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((testimonial) => (
        <div class="relative rounded-2xl border border-border bg-card p-8 transition-all hover:shadow-lg hover:border-secondary/50">
          <!-- Quote Icon -->
          <div class="absolute -top-4 left-8">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-secondary">
              <Quote class="h-4 w-4 text-primary" />
            </div>
          </div>

          <!-- Rating -->
          <div class="flex gap-1 mb-4 pt-2">
            {Array.from({ length: testimonial.rating }).map(() => (
              <Star class="h-5 w-5 fill-secondary text-secondary" />
            ))}
          </div>

          <!-- Content -->
          <p class="text-muted-foreground leading-relaxed mb-6">
            &ldquo;{testimonial.content}&rdquo;
          </p>

          <!-- Author -->
          <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white font-bold">
              {testimonial.name
                .split(" ")
                .map((n) => n[0])
                .join("")}
            </div>
            <div>
              <p class="font-semibold text-foreground">
                {testimonial.name}
              </p>
              <p class="text-sm text-muted-foreground">
                {testimonial.role}, {testimonial.company}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
