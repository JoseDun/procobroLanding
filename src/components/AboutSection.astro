---
import { Target, Eye, CheckCircle2 } from 'lucide-astro';

const values = [
  "Compromiso con la excelencia",
  "Integridad y transparencia",
  "Innovación constante",
  "Orientación al cliente",
  "Responsabilidad social",
  "Trabajo en equipo",
];
---

<section id="nosotros" class="py-20 lg:py-32 bg-background">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-sm font-semibold uppercase tracking-wider text-secondary mb-4">
        Quiénes Somos
      </span>
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        Nuestra <span class="text-secondary">Visión y Misión</span>
      </h2>
    </div>

    <!-- Vision & Mission Cards -->
    <div class="grid gap-8 lg:grid-cols-2 mb-16">
      <!-- Mission -->
      <div class="relative rounded-2xl border border-border bg-card p-8 lg:p-10 overflow-hidden">
        <div class="absolute top-0 right-0 h-32 w-32 -translate-y-1/2 translate-x-1/2 rounded-full bg-secondary/10 blur-3xl"></div>
        <div class="relative">
          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary text-white mb-6">
            <Target class="h-7 w-7" />
          </div>
          <h3 class="text-2xl font-bold text-foreground mb-4">
            Nuestra Misión
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Proporcionar servicios de gestión de cobranza y atención al
            cliente de la más alta calidad, utilizando tecnología de punta y
            un equipo humano comprometido, para maximizar la recuperación de
            cartera de nuestros clientes mientras mantenemos relaciones
            respetuosas y profesionales con los deudores.
          </p>
        </div>
      </div>

      <!-- Vision -->
      <div class="relative rounded-2xl border border-border bg-card p-8 lg:p-10 overflow-hidden">
        <div class="absolute top-0 right-0 h-32 w-32 -translate-y-1/2 translate-x-1/2 rounded-full bg-primary/10 blur-3xl"></div>
        <div class="relative">
          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-secondary text-primary mb-6">
            <Eye class="h-7 w-7" />
          </div>
          <h3 class="text-2xl font-bold text-foreground mb-4">
            Nuestra Visión
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Ser reconocidos como la empresa líder en gestión de cobranza y
            servicios empresariales en Latinoamérica, destacando por nuestra
            innovación tecnológica, excelencia operativa y compromiso con la
            satisfacción de nuestros clientes y el bienestar de la
            comunidad.
          </p>
        </div>
      </div>
    </div>

    <!-- Values -->
    <div class="rounded-2xl border border-border bg-primary p-8 lg:p-12">
      <div class="text-center mb-10">
        <h3 class="text-2xl font-bold text-white">
          Nuestros Valores
        </h3>
        <p class="mt-2 text-white/70">
          Los principios que guían nuestro trabajo diario
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {values.map((value) => (
          <div class="flex items-center gap-3 rounded-xl bg-white/10 px-4 py-3 backdrop-blur-sm">
            <CheckCircle2 class="h-5 w-5 text-secondary flex-shrink-0" />
            <span class="text-white font-medium">{value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
