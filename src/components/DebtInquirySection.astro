---
import { Search, FileSearch, AlertCircle, CheckCircle2 } from 'lucide-astro';
---

<section id="saber-deuda" class="py-20 lg:py-32 bg-primary">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-secondary">
          <FileSearch class="h-8 w-8 text-primary" />
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Consulta tu Deuda
        </h2>
        <p class="mt-4 text-lg text-white/70">
          Ingresa tu RUT para conocer el estado de tu situación crediticia
          con nuestros clientes.
        </p>
      </div>

      <!-- Form Card -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
        <!-- Form -->
        <form id="debt-form" class="space-y-6">
          <div class="space-y-2">
            <label for="rut" class="block text-sm font-medium text-white">
              RUT (sin puntos ni guión)
            </label>
            <div class="relative">
              <Search class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-white/50" />
              <input
                id="rut"
                name="rut"
                type="text"
                placeholder="12.345.678-9"
                class="h-12 w-full rounded-md border border-white/20 bg-white/10 pl-11 pr-4 text-white placeholder:text-white/50 focus:border-secondary focus:outline-none focus:ring-2 focus:ring-secondary/50"
                required
              />
            </div>
            <p class="text-sm text-white/50">
              Formato: 12.345.678-9
            </p>
          </div>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center rounded-md bg-secondary px-6 py-3 text-base font-semibold text-primary hover:bg-secondary/90 transition-colors disabled:opacity-50"
          >
            <Search class="mr-2 h-5 w-5" />
            <span id="submit-text">Consultar Deuda</span>
          </button>

          <p class="text-center text-sm text-white/50">
            Tu información es confidencial y está protegida según la Ley
            de Protección de Datos.
          </p>
        </form>

        <!-- Success Result -->
        <div id="result-found" class="hidden text-center py-6">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-orange-500/20">
            <AlertCircle class="h-8 w-8 text-orange-400" />
          </div>
          <h3 class="text-xl font-bold text-white mb-2">
            Deuda Encontrada
          </h3>
          <p class="text-white/70 mb-6">
            Hemos encontrado información asociada a tu RUT. Por favor,
            contacta a nuestro equipo para conocer los detalles y opciones
            de pago.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
            <a
              href="#contacto"
              class="inline-flex items-center justify-center rounded-md bg-secondary px-6 py-3 text-sm font-medium text-primary hover:bg-secondary/90 transition-colors"
            >
              Contactar Ahora
            </a>
            <button
              id="reset-found"
              class="inline-flex items-center justify-center rounded-md border border-white/30 px-6 py-3 text-sm font-medium text-white hover:bg-white/10 transition-colors"
            >
              Nueva Consulta
            </button>
          </div>
        </div>

        <!-- Not Found Result -->
        <div id="result-not-found" class="hidden text-center py-6">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-green-500/20">
            <CheckCircle2 class="h-8 w-8 text-green-400" />
          </div>
          <h3 class="text-xl font-bold text-white mb-2">
            Sin Deudas Registradas
          </h3>
          <p class="text-white/70 mb-6">
            No encontramos deudas asociadas a tu RUT en nuestro sistema.
            Si crees que esto es un error, contáctanos.
          </p>
          <button
            id="reset-not-found"
            class="inline-flex items-center justify-center rounded-md border border-white/30 px-6 py-3 text-sm font-medium text-white hover:bg-white/10 transition-colors"
          >
            Nueva Consulta
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('debt-form') as HTMLFormElement;
  const rutInput = document.getElementById('rut') as HTMLInputElement;
  const submitText = document.getElementById('submit-text');
  const resultFound = document.getElementById('result-found');
  const resultNotFound = document.getElementById('result-not-found');
  const resetFound = document.getElementById('reset-found');
  const resetNotFound = document.getElementById('reset-not-found');

  // Format RUT
  const formatRut = (value: string) => {
    let cleaned = value.replace(/[^0-9kK]/g, "");
    if (cleaned.length > 9) cleaned = cleaned.slice(0, 9);
    if (cleaned.length > 1) {
      const body = cleaned.slice(0, -1);
      const dv = cleaned.slice(-1);
      const formatted = body.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
      return `${formatted}-${dv.toUpperCase()}`;
    }
    return cleaned;
  };

  rutInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    target.value = formatRut(target.value);
  });

  // Form submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    if (submitText) submitText.textContent = 'Consultando...';
    
    setTimeout(() => {
      form.classList.add('hidden');
      
      // Random result for demo
      if (Math.random() > 0.5) {
        resultFound?.classList.remove('hidden');
      } else {
        resultNotFound?.classList.remove('hidden');
      }
    }, 1500);
  });

  // Reset functions
  const resetForm = () => {
    form?.classList.remove('hidden');
    resultFound?.classList.add('hidden');
    resultNotFound?.classList.add('hidden');
    if (rutInput) rutInput.value = '';
    if (submitText) submitText.textContent = 'Consultar Deuda';
  };

  resetFound?.addEventListener('click', resetForm);
  resetNotFound?.addEventListener('click', resetForm);
</script>
